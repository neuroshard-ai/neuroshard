# Example: adapt paths, home and user before installation.
[Unit]
Description=NeuroShard bounded native training sponsor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=12
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.neuroshard/runtimes/0.4.0
Environment=ATEN_CPU_CAPABILITY=default MKL_ENABLE_INSTRUCTIONS=SSE4_2 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
ExecStart=/home/ubuntu/.neuroshard/runtimes/0.4.0/bin/python -m neuroshard.publicnet.worker_cli sponsor --home /home/ubuntu/.neuroshard/llm-testnet-1/node0 --tasks 10000 --budget-file /home/ubuntu/.neuroshard/llm-testnet-1/sponsor-budget.json --port 39660 --wait-seconds 0 --interval-seconds 300
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.neuroshard/llm-testnet-1
MemoryMax=3G
UMask=0077

[Install]
WantedBy=multi-user.target
