# Example: adapt paths, home and user before installation.
[Unit]
Description=NeuroShard LLM native node %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=12
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.neuroshard/runtimes/0.4.0
Environment=ATEN_CPU_CAPABILITY=default MKL_ENABLE_INSTRUCTIONS=SSE4_2 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
ExecStart=/home/ubuntu/.neuroshard/runtimes/0.4.0/bin/python -m neuroshard.inference.node run --home /home/ubuntu/.neuroshard/llm-testnet-1/%i
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.neuroshard/llm-testnet-1/%i
MemoryMax=3G
UMask=0077

[Install]
WantedBy=multi-user.target
